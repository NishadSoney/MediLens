# ==============================================================================
# MediLens Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your own API keys.
# ==============================================================================

# 1. PRIMARY AI ENGINE: Google Gemini
# Get your free key at: https://aistudio.google.com/
# Default model: gemini-3.5-flash (with automatic fallback to gemini-3.5-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. FIRST FALLBACK: Groq Cloud (Ultra-Fast LPU Inference)
# Get your free key at: https://console.groq.com/
# Default model: openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 3. SECOND FALLBACK / OFFLINE PRIVACY ENGINE: Meta Llama 3.1 (Local Ollama)
# Download Ollama from: https://ollama.com/
# Terminal commands to install models:
#   ollama pull llama3.1
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# 4. SYSTEM ACTIVE DEFAULT MODEL
# Choose: 'gemini', 'groq', or 'llama3.1'
DEFAULT_MODEL=gemini
